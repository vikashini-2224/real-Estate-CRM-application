datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("SALES_EMPLOYEE") // ADMIN | SALES_EMPLOYEE
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedLeads Lead[]    @relation("AssignedLeads")
  notes         Note[]
  bookings      Booking[]

  @@map("users")
}

model Lead {
  id           String    @id @default(uuid())
  name         String
  email        String?
  phone        String
  stage        String    @default("NEW") // NEW, CONTACTED, SITE_VISIT, INTERESTED, NEGOTIATION, BOOKED, LOST
  budget       Float?
  requirement  String?
  followUpDate DateTime?
  assignedToId String?
  assignedTo   User?     @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  notes        Note[]
  booking      Booking?
  
  interestedProjectId  String?
  interestedProject    Project?  @relation(fields: [interestedProjectId], references: [id], onDelete: SetNull)
  interestedBuildingId String?
  interestedBuilding   Building? @relation(fields: [interestedBuildingId], references: [id], onDelete: SetNull)
  interestedUnitId     String?
  interestedUnit       Unit?     @relation(fields: [interestedUnitId], references: [id], onDelete: SetNull)
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([stage])
  @@index([assignedToId])
  @@index([followUpDate])
  @@map("leads")
}

model Note {
  id        String   @id @default(uuid())
  content   String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leadId])
  @@map("notes")
}

model Project {
  id          String     @id @default(uuid())
  name        String
  location    String
  description     String?
  buildings       Building[]
  interestedLeads Lead[]
  createdAt       DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("projects")
}

model Building {
  id        String   @id @default(uuid())
  name      String
  projectId String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  units           Unit[]
  interestedLeads Lead[]
  createdAt       DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("buildings")
}

model Unit {
  id         String   @id @default(uuid())
  unitNumber String
  type       String   // STUDIO, ONE_BHK, TWO_BHK, THREE_BHK, FOUR_BHK, PENTHOUSE, VILLA
  price      Float
  status     String   @default("AVAILABLE") // AVAILABLE, RESERVED, BOOKED
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  version         Int      @default(1)
  booking         Booking?
  interestedLeads Lead[]
  createdAt       DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([buildingId, unitNumber])
  @@index([status])
  @@map("units")
}

model Booking {
  id            String   @id @default(uuid())
  leadId        String   @unique // Guarantee: 1 lead has at most 1 active booking
  lead          Lead     @relation(fields: [leadId], references: [id], onDelete: Restrict)
  unitId        String   @unique // Critical Business Guarantee: 1 unit can only ever be booked once
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)
  bookingAmount Float
  finalPrice    Float
  status        String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  bookingDate   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@map("bookings")
}
